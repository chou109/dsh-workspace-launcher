{
  "name": "dsh-workspace-launcher",
  "version": "2.0.0",
  "private": true,
  "description": "Open the current workspace in the system file manager (Explorer), VS Code, or a terminal from the Session header (DSH 0.2.x).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
