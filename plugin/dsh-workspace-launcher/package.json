{
  "name": "dsh-workspace-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Open the current workspace in the system file manager (Explorer), VS Code, or a terminal, from the session header.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
